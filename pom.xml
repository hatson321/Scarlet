<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.sybyline</groupId>
  <artifactId>scarlet</artifactId>
  <version>0.6.1-a11</version><!--scarlet-version-->
  <name>Scarlet</name>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
      <resource>
        <directory>${project.build.directory}/generated-resources/dependency-notices</directory>
        <targetPath>META-INF/third-party</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>${project.build.directory}/dependency-metadata</directory>
        <targetPath>META-INF/third-party-metadata</targetPath>
        <filtering>false</filtering>
        <includes><include>**/*.pom</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions><execution>
          <id>preserve-upstream-notices</id><phase>generate-resources</phase>
          <goals><goal>unpack-dependencies</goal></goals>
          <configuration>
            <includeScope>runtime</includeScope>
            <includes>**/*LICENSE*,**/*license*,**/*NOTICE*,**/*notice*,**/COPYING*,**/COPYRIGHT*,**/AUTHORS*,META-INF/maven/**/pom.xml</includes>
            <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
            <outputDirectory>${project.build.directory}/generated-resources/dependency-notices</outputDirectory>
          </configuration>
        </execution><execution>
          <id>preserve-upstream-poms</id><phase>generate-resources</phase>
          <goals><goal>copy-dependencies</goal></goals>
          <configuration>
            <includeScope>runtime</includeScope>
            <copyPom>true</copyPom><addParentPoms>true</addParentPoms>
            <useRepositoryLayout>true</useRepositoryLayout>
            <outputDirectory>${project.build.directory}/dependency-metadata</outputDirectory>
          </configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <!-- Maintainer-only tests use the required JDK 21; application bytecode stays Java 8. -->
          <testSource>21</testSource>
          <testTarget>21</testTarget>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- Tests must never discover, prompt for, or write to a maintainer's real Scarlet data folder. -->
          <!-- Java caches its temporary directory before Surefire installs systemPropertyVariables. -->
          <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true -Djava.io.tmpdir="${scarlet.test.root}" -Duser.home="${scarlet.test.root}/test-user"</argLine>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
            <java.util.prefs.PreferencesFactory>net.sybyline.scarlet.TestPreferencesFactory</java.util.prefs.PreferencesFactory>
            <SCARLET_HOME>${scarlet.test.root}/test-scarlet-home</SCARLET_HOME>
            <java.io.tmpdir>${scarlet.test.root}</java.io.tmpdir>
            <user.home>${scarlet.test.root}/test-user</user.home>
          </systemPropertyVariables>
          <environmentVariables>
            <APPDATA>${scarlet.test.root}/test-roaming</APPDATA>
            <LOCALAPPDATA>${scarlet.test.root}/test-local</LOCALAPPDATA>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>net.sybyline.scarlet.Scarlet</mainClass>
              <addClasspath>true</addClasspath>
            </manifest>
            <manifestEntries>
              <Scarlet-VRChatApi-Version>${vrchatapi.version}</Scarlet-VRChatApi-Version>
              <Implementation-Title>${project.artifactId}</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
              <Implementation-Vendor>${project.groupId}</Implementation-Vendor>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
        </configuration>
        <executions>
          <!-- ================================================================
               PowerPC edition - attached as a classifier, always built.
               Output: target/scarlet-${version}-ppc.jar
               Identical desktop payload to shade-full, but its manifest carries
               Scarlet-Edition=ppc. When that jar runs on a PowerPC CPU (e.g. a
               Wii on Wii-Linux, where Java has no JIT), Scarlet skips the
               startup SecurityRegressionChecks self-tests, whose 100k-round
               PBKDF2 derivations take many minutes in the interpreter.
               ================================================================ -->
          <execution>
            <id>shade-ppc</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>ppc</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>net.sybyline.scarlet.Scarlet</mainClass>
                  <manifestEntries>
                    <Scarlet-VRChatApi-Version>${vrchatapi.version}</Scarlet-VRChatApi-Version>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor>${project.groupId}</Implementation-Vendor>
                    <Scarlet-Edition>ppc</Scarlet-Edition>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>moe.kyokobot.libdave:libdave-jvm-impl</artifact>
                  <excludes>
                    <exclude>moe/kyokobot/libdave/natives/DaveNativeBindings.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <!-- ================================================================
               Main distribution jar. Replaces the Maven main artifact.
               Output: target/scarlet-${version}.jar
               ================================================================ -->
          <execution>
            <id>shade-full</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>net.sybyline.scarlet.Scarlet</mainClass>
                  <manifestEntries>
                    <Scarlet-VRChatApi-Version>${vrchatapi.version}</Scarlet-VRChatApi-Version>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor>${project.groupId}</Implementation-Vendor>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>linux-ppc/**</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>moe.kyokobot.libdave:libdave-jvm-impl</artifact>
                  <excludes>
                    <exclude>moe/kyokobot/libdave/natives/DaveNativeBindings.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          <!-- ================================================================
               Debug edition — attached as a classifier, always built by
               `mvnd clean package` (just not necessarily released).
               Output: target/scarlet-${version}-debug.jar
               Identical desktop payload to shade-full, but its manifest carries
               Scarlet-Debug=true, which unlocks the in-app Debug menu (event
               simulation, sample-data injection, offline start) so a tester can
               exercise features without real VRChat/Discord setup. Release jars
               (shade-full) never carry the marker, so debug tools can't appear
               in a normal build.
               ================================================================ -->
          <execution>
            <id>shade-debug</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>debug</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>net.sybyline.scarlet.Scarlet</mainClass>
                  <manifestEntries>
                    <Scarlet-VRChatApi-Version>${vrchatapi.version}</Scarlet-VRChatApi-Version>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor>${project.groupId}</Implementation-Vendor>
                    <Scarlet-Debug>true</Scarlet-Debug>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>linux-ppc/**</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>moe.kyokobot.libdave:libdave-jvm-impl</artifact>
                  <excludes>
                    <exclude>moe/kyokobot/libdave/natives/DaveNativeBindings.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
          

        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>sonatype-snapshots</id>
      <url>https://oss.sonatype.org/content/repositories/snapshots</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
    <repository>
      <id>jetbrains-intellij-dependencies</id>
      <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
    </repository>
  </repositories>
  <properties>
    <scarlet.test.root>${project.build.directory}</scarlet.test.root>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <vrchatapi.version>1.23.0</vrchatapi.version>
    <JDA.version>6.3.0</JDA.version>
    <jna.version>5.18.1</jna.version>
    <okhttp.version>5.3.2</okhttp.version>
    <okio.version>3.16.4</okio.version>
    <kotlin.version>2.2.21</kotlin.version>
    <libdave.version>1.0.0</libdave.version>
    <libdave.native.version>0.1.2</libdave.native.version>
    <junit.version>5.11.4</junit.version>
  </properties>
